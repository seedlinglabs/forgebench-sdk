{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk-py",
  "projectType": "library",
  "tags": [
    "lang:python",
    "scope:sdk"
  ],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "if command -v uv >/dev/null 2>&1; then uv venv --quiet --allow-existing .venv && uv pip install --quiet --python .venv/bin/python -e \".[dev]\"; else python -m venv .venv && .venv/bin/python -m pip install --quiet -e \".[dev]\"; fi",
        "cwd": "packages/sdk-py"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/python -m pytest -q -p no:cacheprovider",
        "cwd": "packages/sdk-py"
      },
      "inputs": [
        "code",
        "{workspaceRoot}/packages/sdk-contract/retry.json",
        "{projectRoot}/pyproject.toml",
        {
          "runtime": "packages/sdk-py/.venv/bin/python --version"
        },
        {
          "runtime": "packages/sdk-py/.venv/bin/python -m pip freeze"
        }
      ]
    }
  }
}
